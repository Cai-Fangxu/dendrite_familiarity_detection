Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<g1IntTest\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g1IntTest", "[", 
    RowBox[{
    "b_", ",", " ", "k_", ",", " ", "nd_", ",", " ", "ns_", ",", " ", "ndR_", 
     ",", " ", "beta_", ",", " ", "w_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "bk", ",", " ", "bla", ",", " ", "bkTmp", ",", " ", "kFactor", ",", " ",
        "part1", ",", " ", "part2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"bk", "=", 
       RowBox[{"b", "+", "k"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bla", " ", "=", "  ", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", "2", "]"}], "w", " ", 
          RowBox[{"InverseErfc", "[", 
           FractionBox[
            RowBox[{"2", "ndR"}], "nd"], "]"}]}], ",", " ", 
         RowBox[{"-", "100"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pUpdated", " ", "=", 
       RowBox[{"ndR", "/", "nd"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"kFactor", " ", "=", " ", 
       RowBox[{"ndR", " ", 
        RowBox[{"oneOverN", "[", 
         RowBox[{"nd", ",", " ", "pUpdated"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bkTmp", " ", "=", " ", 
       RowBox[{
        RowBox[{"k", " ", "kFactor"}], " ", "+", " ", "b"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"part1", " ", "=", " ", 
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "2."}], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             SuperscriptBox["bla", "2"], "2"]}]], "  ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"bkTmp", " ", "ns"}], "+", 
            RowBox[{"bla", " ", 
             RowBox[{"(", 
              RowBox[{"beta", "-", "ns"}], ")"}], " ", "w"}]}], ")"}]}], "+", 
         
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"beta", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "ns"}], ")"}]}], "+", "ns"}], ")"}], 
          SqrtBox[
           RowBox[{"2", " ", "\[Pi]"}]], "w", " ", 
          RowBox[{"Erfc", "[", 
           FractionBox["bla", 
            SqrtBox["2"]], "]"}]}]}], 
        RowBox[{"2", " ", "ns", " ", "w", 
         SqrtBox[
          RowBox[{"2", " ", "\[Pi]"}]]}]]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"part2", " ", "=", " ", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"gTmp1", "[", 
           RowBox[{"x", ",", " ", "b", ",", " ", 
            RowBox[{"ndR", " ", "k"}], ",", "beta", ",", " ", "ns", ",", " ", 
            "w"}], " ", "]"}], 
          FractionBox[
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox["x", "2"]}], "/", "2"}], "]"}], 
           RowBox[{"Sqrt", "[", 
            RowBox[{"2.", "\[Pi]"}], " ", "]"}]], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"q", "[", "x", "]"}]}], ")"}], 
           RowBox[{"nd", "-", "1"}]]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "Infinity"}], ",", " ", "bla"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "bla", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "part1", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "part2", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"part1", "+", "part2"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"g1IntTest", "[", 
  RowBox[{
  "2.55", ",", " ", "1.45", ",", " ", "300", ",", " ", "200", ",", " ", "3", ",",
    " ", "13.0881", ",", " ", "1.0"}], "]"}], "\[IndentingNewLine]", 
